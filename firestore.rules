rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid));
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staffProfiles/$(request.auth.uid))
        && profile().data.active == true
        && profile().data.role in ['staff', 'admin'];
    }

    function isAdmin() {
      return isStaff() && profile().data.role == 'admin';
    }

    function isAssignedStaffForReservation() {
      return isStaff()
        && profile().data.role == 'staff'
        && resource.data.menuId in profile().data.assignedMenuIds;
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /reservations/{reservationId} {
      allow read: if isAdmin() || isAssignedStaffForReservation();
      allow write: if false;
    }

    match /reservationEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /operationEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /staffProfiles/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

